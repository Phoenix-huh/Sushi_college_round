# Copy to .env (never commit .env)

# Supabase (optional: without it the server runs on an in-memory store)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Server (hosting platforms set PORT themselves; SERVER_PORT is for your own machine)
SERVER_PORT=4000
# Web pages allowed to call the API, comma separated. Leave empty locally (anything is allowed).
# On a public server list the demo site and the dashboard, e.g. https://techmart.vercel.app,https://patchwork-dash.vercel.app
# localhost is always allowed, and the extension is not affected by this setting.
CORS_ORIGINS=http://localhost:5173

# The public address of the demo site. Seed data and AI drafts use it as their target page,
# so the Chrome extension recognises them on the deployed site. (default: http://localhost:4100)
# DEMO_URL=https://techmart.vercel.app

# Demo site (local server: it loads patches from SERVER_URL; defaults to http://localhost:SERVER_PORT)
DEMO_PORT=4100
# SERVER_URL=http://localhost:4000
# For the Vercel build (apps/demo-site, `npm run build:static`) SERVER_URL is REQUIRED and must be https:
# SERVER_URL=https://patchwork-api.example.com

# Extension: the server a freshly built extension talks to (PATCHWORK_SERVER_URL=... npm run build -w apps/extension)
# PATCHWORK_SERVER_URL=https://patchwork-api.example.com

# Pre-flight check (npm run check:deploy) reads DEMO_URL, SERVER_URL and optionally:
# DASHBOARD_URL=https://patchwork-dash.vercel.app

# Dashboard (read from this same file via vite envDir)
VITE_SERVER_URL=http://localhost:4000
VITE_DEMO_URL=http://localhost:4100

# AI (natural-language patches): https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
