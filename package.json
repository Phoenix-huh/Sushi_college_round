{
  "name": "patchwork",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*",
    "flows"
  ],
  "scripts": {
    "demo": "concurrently -n demo,server,dash -c blue,green,magenta \"npm run dev -w apps/demo-site\" \"npm run dev -w apps/server\" \"npm run dev -w apps/dashboard\"",
    "seed": "tsx apps/server/src/seed.ts",
    "e2e": "tsx scripts/e2e-dashboard-to-site.ts",
    "e2e:ext": "tsx scripts/e2e-extension.ts",
    "check:deploy": "tsx scripts/check-deployment.ts",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "happy-dom": "^20.14.6",
    "playwright": "^1.64.0",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3",
    "vitest": "^3.2.1"
  }
}
